/*
 * The one stylesheet every qbit-ops surface reads.
 *
 * Loaded by `QbitOpsTuiApp.CSS_PATH`, and shipped inside the wheel
 * (asserted by `tests/test_distribution.py`) -- a packaging change
 * that dropped it would break only an installed user, never the repo.
 *
 * Brand colours arrive as theme variables (`qbit_ops.tui.theme`):
 * `$primary` *is* the brand orange here, so no rule names a hex.
 */

/* ==== The app frame and its two workspaces ========================= */

Screen {
    layout: vertical;
}
/* Thinner (1 column, Textual's default is 2), brand-orange
   vertical scrollbar. Scrollbar properties do *not* cascade down
   the DOM the way most Textual styles do (confirmed empirically:
   a `Screen`-level declaration alone left every descendant at
   Textual's own default) -- so this is declared once per type,
   against `DataTable`/`VerticalScroll` directly, and reaches the
   torrent table, the Overview scroll area, and every modal's own
   `VerticalScroll` dialog (App-level `CSS` applies across every
   `Screen`, not just the default one). */
DataTable, VerticalScroll {
    scrollbar-size-vertical: 1;
    scrollbar-color: $primary 40%;
    scrollbar-color-hover: $primary 70%;
    scrollbar-color-active: $primary;
    scrollbar-background: $surface;
    scrollbar-corner-color: $surface;
}
MainScreen {
    border: round $panel-lighten-2;
}
/* Narrow terminals drop the decorative outer frame entirely --
   every column is worth more than a floating title there. */
MainScreen.narrow {
    border: none;
}
/* No fill here: the active/inactive tab colours (see `WorkspaceTabs`)
   already carry this row's meaning. */
#top-bar {
    height: 1;
    padding: 0 1;
}
#workspace-tabs {
    width: 1fr;
}
#global-rate {
    width: auto;
}
#banner {
    height: auto;
    padding: 0 1;
    background: $warning-darken-2;
    display: none;
}
#banner.visible {
    display: block;
}
#overview-workspace {
    height: 1fr;
    padding: 0 1;
}
/* Three windows, one grammar. The top one holds the wordmark, the
   instance's status line and the graph; the two below split the rest.
   Every one of them has a fixed or fractional size, never a size read
   off its own content: a window that shrank when its trackers went
   quiet moved the whole page, and page movement that carries no
   information is noise. */
#overview-masthead {
    height: 11;
    border: round $panel-lighten-2;
    border-title-color: $primary;
    border-title-align: left;
    border-subtitle-color: $text-muted;
    border-subtitle-align: right;
    padding: 0 1;
    margin-bottom: 1;
}
/* A fraction, not `auto`. `auto` looked right and was circular:
   `BrandHeader` picks its variant from the width it is *given*, so an
   auto column sized itself from the smallest variant, which then kept
   the header small. Nine to ten leaves the wordmark its full form at
   140 columns and its compact one down to 110, and still gives the plot
   the wider half. */
#overview-identity {
    width: 9fr;
    height: 1fr;
}
/* `1fr`, so the wordmark absorbs the slack and the status rail lands on
   the column's last row -- level with the graph's own bottom legend, so
   both halves of the window end on the same line. */
#brand-header {
    height: 1fr;
}
/* One line, and one line only: the status word changes length with the
   connection, and `overflow: hidden` is what stops a longer word from
   wrapping and pushing every window below it down a row. */
.ov-rail {
    height: 1;
    padding: 0;
    overflow: hidden;
}
/* The separator is a border rather than a drawn character: one rule
   instead of a column of `│` appended to nine strings. */
#rate-graph {
    width: 10fr;
    height: 1fr;
    padding: 0 0 0 1;
    border-left: solid $panel-lighten-2;
    margin-left: 1;
}
/* Three fractions to two: the tracker table has six columns to fit and
   the Session window a label plus a value. An `auto` Session window was
   tried first and rejected -- its width then moved with its longest
   category list, so the tracker table's columns shifted whenever an
   operator added a category. */
#overview-windows {
    height: 1fr;
}
#trackers-window {
    width: 3fr;
    height: 1fr;
    border: round $panel-lighten-2;
    border-title-color: $primary;
    border-title-align: left;
    padding: 0 1;
}
#session-window {
    width: 2fr;
    height: 1fr;
    border: round $panel-lighten-2;
    border-title-color: $primary;
    border-title-align: left;
    padding: 0 1;
    margin-left: 1;
}
/* Narrow terminals stack the two windows instead of squeezing the
   tracker table below the width its columns need. Heights stay fixed
   here too -- the page may scroll, but it may not shuffle. */
MainScreen.narrow #overview-windows {
    layout: vertical;
    height: auto;
}
MainScreen.narrow #trackers-window {
    width: 1fr;
    height: 16;
    margin-left: 0;
}
MainScreen.narrow #session-window {
    width: 1fr;
    height: 22;
    margin-left: 0;
}
MainScreen.narrow #overview-masthead {
    layout: vertical;
    height: 20;
}
/* A cross-axis `fr` in a vertical container does not mean "share of the
   row" -- measured at 96 columns, `4fr` resolved to 372. Pinned back to
   the full width once the masthead stops being a row. */
MainScreen.narrow #overview-identity {
    width: 1fr;
    height: auto;
}
MainScreen.narrow #rate-graph {
    width: 1fr;
    height: 9;
    border-left: none;
    margin-left: 0;
    padding: 0;
}
.ov-stale {
    height: auto;
    color: $warning;
    padding: 0 1;
    display: none;
}
.ov-stale.visible {
    display: block;
}
#filter-summary {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}
#last-action {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    display: none;
}
#last-action.visible {
    display: block;
}
/* Restrained header: a subtle dark surface + muted text, not the
   default bright/bold bar -- and a cursor row that reads as a
   slim warm accent, never Textual's default full-width blue
   block (DataTable's own cursor variable defaults to the theme's
   blue primary colour). The `›`/`✔` glyphs (see `formatting.py`)
   carry the actual focus/selection signal; this background is
   deliberately subtle so it never outcompetes them or the brand. */
#torrents {
    width: 1fr;
    height: 1fr;
    border: round $panel-lighten-2;
    background: transparent;
}
/* DataTable's own DEFAULT_CSS tints its background by 5% on focus
   (`&:focus { background-tint: ... }`), which -- even with the
   `background: transparent` above -- still composited a visibly
   lighter panel than the rest of the app's uniform background
   while the table (the Torrents workspace's default focus target)
   was focused. Zeroed out here to keep the table's background
   genuinely uniform with its surroundings in every focus state. */
#torrents:focus {
    background-tint: transparent;
}
#torrents:focus-within {
    border: round $primary;
}
#torrents > .datatable--header {
    background: $surface;
    color: $text-muted;
    text-style: bold;
}
#torrents > .datatable--cursor {
    background: $panel-lighten-2 60%;
    color: $text;
    text-style: none;
}
#torrents:focus > .datatable--cursor {
    background: $panel-lighten-3 70%;
    color: $text;
    text-style: bold;
}
/* The footer row: `CommandBar` renders every `[key→Description]`
   token plus the live `|search: xxx|` token (see
   `CommandBar.set_search_state`); `FooterTotal` is a `width: auto`
   sibling that `CommandBar`'s own `width: 1fr` pins to the row's
   right edge, showing `|Total: y|` only while search is active.
   `#search-input` is a zero-width, invisible keystroke sink
   mounted alongside them only while search is active (see
   `mount_search_input`). Zero width still keeps a Textual `Input`
   genuinely focusable and able to receive key presses -- confirmed
   empirically, not merely assumed. */
#footer-row {
    height: auto;
}
#command-bar {
    width: 1fr;
    height: auto;
    padding: 0 1;
    border-top: solid $panel-lighten-2;
}
#footer-total {
    width: auto;
    height: auto;
    padding: 0 1;
    border-top: solid $panel-lighten-2;
}
#search-input {
    width: 0;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
}
#search-input:focus {
    border: none;
}
/* Restyle Textual's built-in toast notifications (`self.notify`)
   to the same dark-uniform surface + brand accent as every modal
   -- `-warning`/`-error` keep Textual's own semantic colours
   (see `Toast`'s own `DEFAULT_CSS`), only the default
   `-information` state switches from `$success` green to the
   brand orange, since that's this app's "primary/success" accent. */
Toast {
    background: $surface;
}
Toast.-information {
    border-left: outer $primary;
}
Toast.-information .toast--title {
    color: $primary;
}

/* ==== Modal chrome: one frame, three widths ======================== */

/*
 * Every modal is a `QbitModal` (`tui/modals/base.py`): the frame, the
 * title in the interrupted border, the key hint in the subtitle, the
 * scrolling and the width all come from here. A modal chooses a word
 * (`MODAL_WIDTH`), never a number, which is what stops the tenth one
 * from inventing a fourth width.
 */
QbitModal {
    align: center middle;
}
.qbit-dialog {
    /* Sized to its own content, not to a shared full-screen height --
       centred vertically (`QbitModal { align: center middle; }`)
       rather than pinned to one shared origin. A dialog taller than
       the cap below still scrolls; it just no longer *starts* at
       full height regardless of how little it has to show. */
    height: auto;
    max-height: 90%;
    /* The exact counterpart of `max-height`, and it was missing: the
       three width words below are absolute columns, so `-large`'s 100
       ran its right border off a 96-column terminal. */
    max-width: 100%;
    /* Two columns of sol on either side, even flush against
       `max-width: 100%` -- the reason lives here, not in a percentage
       that happens not to touch either edge (measured: `96%` alone
       gives the same `x=2 w=92` at 96 columns, but says nothing about
       why). */
    margin: 0 2;
    border: round $primary;
    border-title-color: $primary;
    border-title-align: left;
    border-subtitle-color: $text-muted;
    border-subtitle-align: right;
    /* `$background`, not `$surface`: `$surface` is a visibly lighter
       grey, which reads as a grey box clashing with the round border
       rather than an outline floating on a uniform dark ground. */
    background: $background;
    padding: 1 2;
}
.qbit-dialog.-small {
    width: 48;
}
.qbit-dialog.-medium {
    width: 64;
}
/* See `MODAL_WIDTHS`' own comment (`modals/base.py`) for why this
   fourth word exists: `FiltersScreen`'s measured floor, its footer's
   worst case plus the border truncation margin, not its content. */
.qbit-dialog.-wide {
    width: 76;
}
.qbit-dialog.-large {
    width: 100;
}

/* ---- Fields and buttons, once for every dialog -------------------- */

/*
 * Each of these widgets' own `DEFAULT_CSS` fills with `$surface` and
 * accents with Textual's `$primary`/`$border`/`$block-cursor-*`. Left
 * alone, every field reads as its own grey box nested in the dialog,
 * accented in a colour from another palette. Scoped to `.qbit-dialog`
 * so nothing here leaks onto the main screen.
 */
.qbit-dialog RadioSet {
    border: round $panel-lighten-2;
    background: transparent;
    height: auto;
}
.qbit-dialog RadioSet:focus-within {
    border: round $primary;
}
/* A `RadioSet` holds several options behind one shared focus border
   (`RadioSet:focus-within` above); nothing else says which option
   currently has keyboard focus, so its label still needs its own fill.
   `color: $background`, not `$text` (near-white): white on `$primary`
   is roughly 2:1 contrast, the app's own dark ground on it is ~9:1. */
.qbit-dialog RadioSet:focus > RadioButton.-selected > .toggle--label {
    background: $primary;
    color: $background;
    text-style: bold;
}
/* A `Checkbox` is its own widget, not one option among several -- its
   `border-left: heavy $primary` below already marks focus, the same
   signal every focused `Input` in a dialog carries. Painting the label
   itself on top of that, background and all, was measured too strong
   (human feedback: "casse les yeux") for a widget that only ever has
   one focus state to announce. This cancels Textual's own default
   `:focus > .toggle--label` fill (`$block-cursor-background`, which
   resolves to this same brand orange via `primary.hex` -- see
   `design.py`'s derivation -- so leaving no rule here at all would not
   have removed the fill, only hidden which rule painted it). */
.qbit-dialog Checkbox:focus > .toggle--label {
    background: transparent;
    color: $text;
    text-style: none;
}
/* Textual's blurred selection falls back to a translucent `$primary`
   -- which is now the brand orange, so only the alpha is set here. */
.qbit-dialog RadioSet:blur > RadioButton.-selected > .toggle--label {
    background: $primary 30%;
}
/* The "(x)" on-mark defaults to `$text-success` (green): no modal here
   has green/red semantics, only the brand accent. `background:
   transparent`, not the default `$panel` (this theme's dark, distinctly
   blue-tinted grey -- see `theme.py`'s `_PANEL`, `#242f38`): left alone
   it read as a blue patch behind every option, on or off, and --
   before `QbitRadioButton` dropped `BUTTON_LEFT`/`BUTTON_RIGHT` -- also
   coloured the `▐`/`▌` side glyphs themselves, since Textual derives
   their colour from this same background
   (`textual/widgets/_toggle_button.py`'s `_button` property). Human
   feedback: "je vois du bleu, je n'en veux pas". */
.qbit-dialog RadioSet > RadioButton > .toggle--button {
    color: $text-muted;
    background: transparent;
}
.qbit-dialog RadioSet > RadioButton.-on > .toggle--button {
    color: $primary;
}
/* Same reasoning, applied to `QbitCheckbox`'s `✓`/`✗`: `$text-muted`
   off, `$primary` on -- never Textual's default grey/green pairing.
   `background: transparent`, not the default `$panel`: `QbitCheckbox`
   drops `BUTTON_LEFT`/`BUTTON_RIGHT` (see `widgets/checkbox.py`), so a
   `$panel` fill here would paint an isolated patch behind the one
   remaining glyph instead of blending into the row -- the job the two
   blank side glyphs did for free before. */
.qbit-dialog Checkbox > .toggle--button {
    color: $text-muted;
    background: transparent;
}
.qbit-dialog Checkbox.-on > .toggle--button {
    color: $primary;
}
.qbit-dialog Input {
    background: transparent;
}
/* A left accent bar, not a full `border`: every field this app styles
   at `height: 1` (`.f-field`, `.v-field`) has no row to spare for a
   top+bottom border. Measured (`export_screenshot`, then read back the
   `<text>` nodes): `border: tall $primary` here left typed text absent
   from the render entirely -- the single content row *is* the border's
   top edge, filled corner-to-corner with its "-" fill glyph, and the
   widget's own region grows to fit the border regardless of the fixed
   `height: 1` (measured via `.region`: 1 -> 2 while focused, springing
   back on blur -- the whole dialog reflowed under the cursor). A
   left-only edge costs one column, not one row: `_styles_cache.py`
   only takes the destructive top/bottom branch when top or bottom is
   set, and only touches this line's two end cells otherwise. */
.qbit-dialog Input:focus {
    border-left: heavy $primary;
}
.qbit-dialog Checkbox {
    background: transparent;
}
/* Same reasoning and same measurement as `Input:focus` above. */
.qbit-dialog Checkbox:focus {
    border-left: heavy $primary;
}
/* Flat, single-row buttons -- Textual's default `Button` is 3 rows
   tall (a raised, "3D" shadow look) and pulls in `$surface`; both are
   out of place in a restrained, terminal-native dialog. `border: none`
   removes the extra two rows along with the shadow. */
.qbit-dialog Button {
    height: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: $text;
    text-style: none;
}
.qbit-dialog Button:hover {
    background: $panel-lighten-2;
}
.qbit-dialog Button:focus {
    background: $primary 20%;
    color: $primary;
    text-style: bold;
}
.qbit-dialog Button.-primary {
    background: transparent;
    color: $primary;
    text-style: bold;
}
.qbit-dialog Button.-primary:hover {
    background: $primary 20%;
}
.qbit-dialog Button.-primary:focus {
    background: $primary;
    color: $background;
}

/* ==== What each modal owns beyond the shared frame ================= */

/* -- actions -- */
#actions-dialog Button {
    width: 100%;
    margin-bottom: 0;
}
.actions-names {
    color: $text-muted;
    margin-bottom: 1;
}

/* -- sort -- */
/* Measured (`scripts/tui_wireframe.py --inventory`): 48x20 for 14
   one-line options, of which 6 rows were pure chrome -- the dialog's
   own round `$primary` border plus a *second*, near-identical round
   border drawn by the `RadioSet` immediately inside it (the generic
   `.qbit-dialog RadioSet` rule above). One frame already says "this is
   the Sort dialog"; a second one in the same colour repeats it rather
   than adding information. Dropped the same way `.f-tristate` already
   drops it for filters' own `RadioSet`s -- an id selector so it wins
   outright, focused or not, rather than re-fighting the specificity
   tie `.f-tristate` had to. */
#sort-dialog RadioSet {
    border: none;
}

/* -- filters -- */
/* Same reason as `DetailsPanel` below: a panel that fills its dialog
   pins the dialog's virtual size to its own and kills the scrolling.
   Every pane's rows are mounted at once (see `FiltersPanel`); only the
   active pane's are `display`ed, so `height: auto` here always sums to
   exactly `PANE_HEIGHT` rows -- the invariant the modal never resizes
   changing section relies on. */
FiltersPanel {
    height: auto;
}
.f-row {
    height: 1;
    background: transparent;
}
/* Bold and `$text` (87% opacity), not `$text-muted` (60%): two
   distinct levels -- the label names the filter, the field beside it
   carries the value the operator typed, and the two read as one grey
   smear at `$text-muted`'s weight (measured against the field's own
   `color: $foreground` from Textual's `Input` default, brighter still).
   Bold is the reliable half of the split: a colour-only distinction
   this close survives inspection but not a glance. */
.f-label {
    width: 12;
    color: $text;
    text-style: bold;
}
.f-hint {
    width: auto;
    color: $text-muted;
}
/* Textual's `Input` default is 3 rows (a `border: tall` box); this
   modal is a dense grid of them, so every one collapses to the single
   row the wireframe budgets -- a focus ring replaces the border. */
.f-field {
    height: 1;
    width: 18;
    border: none;
    padding: 0 1;
    background: transparent;
}
/* Border only, no background tint: `.qbit-dialog`'s own uniform-
   background invariant (`test_modal_dialog_background_matches_the_
   app_uniform_background`) covers every state, not just blurred, so
   the fill never changes -- but a focused field still needs a signal,
   and the shared `.qbit-dialog Input:focus { border-left: heavy
   $primary; }` rule already supplies the brand-accent one every other
   Input in the app uses. */
.f-field:focus {
    background: transparent;
}
/* Completion/Activity/Private: three mutually exclusive options that
   read as one line, not a three-row stack -- `RadioSet`'s own default
   layout is vertical. Selector qualified to `.qbit-dialog RadioSet`'s
   own specificity (a descendant rule above, in "Fields and buttons,
   once for every dialog"): a bare `.f-tristate` loses the border/
   height fight to it and renders a round box clipped to one row,
   hiding every option inside it. */
.qbit-dialog RadioSet.f-tristate {
    layout: horizontal;
    height: 1;
    width: auto;
    border: none;
    padding: 0;
    background: transparent;
}
.f-tristate > RadioButton {
    width: auto;
    margin-right: 1;
}
.qbit-dialog Checkbox.f-check {
    height: 1;
    width: auto;
    border: none;
    padding: 0 1;
    background: transparent;
}
/* `.qbit-dialog Checkbox:focus` above ties this rule's specificity
   (two classes vs one class + one type), so source order alone would
   decide it -- named explicitly instead, to keep the focus signal
   every other Input/Checkbox in the app already carries. `border-left`,
   not a full border: see the measurement at `Input:focus` above --
   the same destructive-at-`height:1` defect applied here too. */
.qbit-dialog Checkbox.f-check:focus {
    border-left: heavy $primary;
}
.f-spacer,
.f-pending,
.f-error,
.f-count {
    height: 1;
}
.f-rule {
    height: 1;
    margin: 0;
    color: $panel-lighten-2;
}
.f-error {
    color: $text-error;
}

/* -- value-action modals (category set / tag add / tag remove /
   throttle) -- one patron, four instantiations. Same row/field/label
   vocabulary as filters (`.f-row`-style), scoped under `.v-` so the
   two never fight over a shared class name. */
.v-scope {
    color: $text-muted;
    height: 1;
    margin-bottom: 1;
}
.v-row {
    height: 1;
}
/* Same reasoning as `.f-label` above -- the label names the field,
   never the value beside it. */
.v-label {
    width: 13;
    color: $text;
    text-style: bold;
}
.v-field {
    height: 1;
    width: 1fr;
    border: none;
    padding: 0 1;
    background: transparent;
}
.v-field:focus {
    background: transparent;
}
.v-hint {
    height: 1;
    color: $text-muted;
    margin-left: 13;
}
.v-create {
    height: 1;
    width: auto;
    border: none;
    padding: 0 1;
    background: transparent;
    margin-top: 1;
}
.v-verdict {
    height: auto;
    min-height: 1;
    margin-top: 1;
    color: $text-error;
}
/* The "contexte" slot as a labelled block, not a flat `Label   value ·
   value` line: the label owns the blank line above (separating it from
   the field the operator is editing) and reads bold/`$text`, same
   grammar as `.v-label`; the values below it are `.v-source`'s own
   `$text-muted`, one visual step down. Two `Static`s, not one --
   `Content` has no cross-line style boundary to split "Existing" from
   what follows it without one. */
.v-source-label {
    height: 1;
    margin-top: 1;
    color: $text;
    text-style: bold;
}
.v-source {
    height: auto;
    color: $text-muted;
}

/* -- details -- */
/* `height: auto`, not the container default `1fr`: filling the dialog
   would make the dialog's virtual size equal its own, and the modal
   would silently stop scrolling however long the content grew. */
DetailsPanel {
    height: auto;
}
#details-identity {
    height: auto;
    text-align: center;
    margin-bottom: 1;
}
#details-metrics {
    height: auto;
    text-align: center;
}
#details-trackers-heading {
    height: 1;
    text-align: center;
    text-style: bold;
    border-top: solid $panel-lighten-2;
    padding-top: 1;
}
#details-trackers {
    height: auto;
    text-align: center;
}

/* -- preview -- */
#preview-actions {
    height: auto;
    margin-top: 1;
}
#preview-actions Button {
    margin-right: 1;
    width: auto;
}

/* -- result -- */
#result-close {
    margin-top: 1;
}

/* -- setup -- */
#setup-dialog Button {
    width: 100%;
}
.setup-label {
    color: $text-muted;
}
#setup-status {
    margin-top: 1;
    color: $warning;
}

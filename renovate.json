{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>LECOQQ/renovate-config",
    "local>LECOQQ/renovate-config:github"
  ],
  "packageRules": [
    {
      "description": "qbit-ops is published: a runtime or extra dependency change is a fix, so release-please ships it",
      "matchDepTypes": [
        "dependencies",
        "extras"
      ],
      "semanticCommitType": "fix"
    },
    {
      "description": "The compatibility matrix decides which qBittorrent versions are supported; the demo image follows it by hand",
      "matchDepNames": [
        "linuxserver/qbittorrent"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Opengrep is pinned in the scan script and its signature verified by cosign",
      "managerFilePatterns": [
        "/^scripts/sast\\.sh$/"
      ],
      "matchStrings": [
        "OPENGREP_VERSION=\"(?<currentValue>v[0-9.]+)\""
      ],
      "depNameTemplate": "opengrep/opengrep",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Rule sources are pinned to a commit in .sast/sources",
      "managerFilePatterns": [
        "/^\\.sast/sources$/"
      ],
      "matchStrings": [
        "^(?<depName>[\\w.-]+/[\\w.-]+) (?<currentDigest>[a-f0-9]{40}) "
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Semgrep CE is pinned in the scan script",
      "managerFilePatterns": [
        "/^scripts/sast\\.sh$/"
      ],
      "matchStrings": [
        "SEMGREP_VERSION=\"(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "semgrep",
      "datasourceTemplate": "pypi"
    }
  ]
}
